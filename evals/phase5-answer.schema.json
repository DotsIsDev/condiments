{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["answer", "evidence", "commands"],
  "properties": {
    "answer": { "type": "string" },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "line", "quote"],
        "properties": {
          "file": { "type": "string" },
          "line": { "type": "integer", "minimum": 1 },
          "quote": { "type": "string" }
        }
      }
    },
    "commands": { "type": "array", "items": { "type": "string" } }
  }
}

