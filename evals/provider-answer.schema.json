{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["symbol", "file", "line", "evidence"],
  "properties": {
    "symbol": { "type": "string" },
    "file": { "type": "string" },
    "line": { "type": "integer", "minimum": 1 },
    "evidence": { "type": "string" }
  }
}

